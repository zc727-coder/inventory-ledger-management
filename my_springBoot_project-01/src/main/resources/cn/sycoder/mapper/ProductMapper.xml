<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.sycoder.mapper.ProductMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.sycoder.domain.Product">
        <id column="product_id" property="productId" />
        <result column="product_name" property="productName" />
        <result column="inventory_sum" property="inventorySum" />
        <result column="inventory" property="inventory" />
        <result column="inventory_remove" property="inventoryRemove" />
        <result column="unit" property="unit" />
        <result column="location" property="location" />
        <result column="alarm" property="alarm" />
        <result column="product_code" property="productCode" />
        <result column="alarm_value" property="alarmValue" />
        <result column="product_type" property="productType" />
        <result column="img" property="img" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="deleted" property="deleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        product_id, product_name, inventory_sum, inventory, inventory_remove, unit, location, alarm, product_code, alarm_value, product_type, img, create_by, update_by, create_time, update_time, deleted
    </sql>

</mapper>
